{
  "expo": {
    "name": "PurpleBox",
    "slug": "purplebox-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "purplebox",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.purplebox.client"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B2BC9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.purplebox.client",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B2BC9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#5B2BC9"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "PurpleBox uses the camera to photograph your Emirates ID or passport for your storage agreement.",
          "photosPermission": "PurpleBox needs your photos so you can upload your Emirates ID or passport."
        }
      ],
      "expo-sharing",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42e78a4b-8d68-47d4-9725-68246bcc1f70"
      }
    },
    "owner": "xulfi"
  }
}
